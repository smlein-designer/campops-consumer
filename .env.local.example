# Copy this file to .env.local and fill in your key.
# Required for /api/intent (structured intent extraction via GPT-5.4 mini).
OPENAI_API_KEY=

# Optional, public-demo rate limiting for /api/intent (10 requests/minute/IP
# via Upstash Redis — see src/lib/rate-limit.ts and
# docs/implementation-decisions.md). If either is left blank, rate limiting
# is silently disabled — normal for local development. In production, set
# both (Vercel → Project → Settings → Environment Variables) to enable it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
